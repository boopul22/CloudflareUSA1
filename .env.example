# Google Apps Script web app URL for form submissions
# See google-apps-script.js for setup instructions
VITE_GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# FormSubmit.co AJAX endpoint for email notifications
# Use https://formsubmit.co/ajax/YOUR_EMAIL_OR_HASH
# See FORM_SETUP_GUIDE.md and public/activate-formsubmit.html for activation
VITE_FORMSUBMIT_URL=https://formsubmit.co/ajax/YOUR_EMAIL_OR_HASH

# CC email for FormSubmit notifications (receives a copy of every submission)
VITE_FORMSUBMIT_CC=

# Gemini API key (for AI features)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
